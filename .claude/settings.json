{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/session-start.sh\"",
            "timeout": 15,
            "statusMessage": "טוען את תיעוד הסשנים"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/session-end.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
