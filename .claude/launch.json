{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "web-dev-3100",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "exec",
        "next",
        "dev",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "visual-refresh-3300",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        ".claude/worktrees/visual-refresh/web",
        "exec",
        "next",
        "dev",
        "--port",
        "3300"
      ],
      "port": 3300
    },
    {
      "name": "prototypes",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "--directory",
        "design/prototypes"
      ],
      "port": 4321
    },
    {
      "name": "web-closed-3200",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:NEXT_PUBLIC_VERCEL_ENV='production'; pnpm --dir web exec next dev --port 3200"
      ],
      "port": 3200
    }
  ]
}
