# מקומי: הערכים מ-pnpm db:status בשורש הפרויקט
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# סודי: לסקריפטים בשרת ולנתיב מחיקת החשבון (src/app/api/account/delete). אף פעם לא בקוד שרץ בדפדפן.
SUPABASE_SECRET_KEY=
# אופציונלי וסודי: הבנת המשפט החופשי בדף הבית (claude-haiku-5-5). בלי מפתח, האתר משתמש בהתאמת מילים.
# אף פעם לא עם הקידומת NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# אופציונלי וסודי: הטוקן של /api/revalidate, שמרענן את הדפים אחרי חישוב הציונים. לפחות 32 תווים.
# באוויר: ב-Vercel וב-GitHub Secrets בלבד. מקומית רק לבדיקה של הנתיב, עם טוקן זמני אחר.
REVALIDATE_TOKEN=
# לאן הסקריפט של הציונים שולח את הרענון. ב-GitHub Actions: הכתובת של האתר באוויר. מקומית: ריק, או
# http://localhost:3000 לבדיקה. מסד מקומי לא מרענן אתר באוויר.
REVALIDATE_URL=
